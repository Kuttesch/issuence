{
  "name": "backend",
  "version": "0.0.2",
  "description": "",
  "main": "dist/main.js",
  "build": {
    "appId": "com.kuttesch.Issuence",
    "productName": "Issuence",
    "directories": {
      "output": "dist",
      "buildResources": "src"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "data/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.png"
    }
  },
  "scripts": {
    "dev": "pnpm run build-ts && pnpm run start",
    "start": "electron .",
    "build-ts": "npx tsc",
    "build-electron": "npx electron-builder",
    "build": "pnpm run build-ts && pnpm run build-electron",
    "prettier": "prettier --write .",
    "db:create": "tsx db/database.ts --init"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "electron": "^34.1.1",
    "pnpm-run": "0.0.1-security",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "~5.7.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "prettier": "^3.5.1"
  }
}
